[Unit]
Description=HazardHub Server (Distributed Hazard Monitoring)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=__HUB_USER__
WorkingDirectory=__REPO_DIR__
Environment="PYTHONUNBUFFERED=1"
Environment="UDP_PORT=39394"
ExecStart=__REPO_DIR__/.venv/bin/uvicorn server.HttpServer.web_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
